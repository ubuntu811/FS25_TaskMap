<?xml version="1.0" encoding="utf-8" standalone="no"?>
<modDesc descVersion="94">
    <author>ubuntu811</author>
    <version>0.6.0.0</version>
    <title>
        <en>TaskMap</en>
    </title>
    <description>
        <en><![CDATA[
Shows letters over any farmed ground that currently has an open job (ready
to harvest, needs weeding/plowing/seeding/rolling/fertilizer/lime), right
on the minimap/map. Finds farmed ground directly, not just the map's
pre-defined fields, so tillage-expanded and player-merged areas are covered
too -- including rice paddies spanning multiple underlying fields as one
label. Purely additive -- doesn't touch or replace any existing map
overlay, so it plays fine alongside other minimap mods. Requires
FS25_whatAmILookingAt (WAILA) -- it owns the actual field scan/tracking
now, this mod just draws from it.

Formerly SmartMinimapAuto -- renamed for searchability, no functional
change from the rename itself.
]]></en>
    </description>
    <iconFilename>icon.dds</iconFilename>
    <multiplayer supported="true" />

    <dependencies>
        <dependency>FS25_whatAmILookingAt</dependency>
    </dependencies>

    <extraSourceFiles>
        <sourceFile filename="scripts/FieldJobHotspot.lua" />
        <sourceFile filename="scripts/MarkerOverrides.lua" />
        <sourceFile filename="scripts/FieldClick.lua" />
        <sourceFile filename="scripts/LabelPlacement.lua" />
        <sourceFile filename="scripts/TaskMap.lua" />
    </extraSourceFiles>

    <actions>
        <!-- No category attribute: same reasoning WAILA's own
             WAILA_TOGGLE_HUD comment already covers. category="ONFOOT"
             auto-deactivates while in a vehicle regardless of Lua-side
             registration, and this needs to work from the driver's seat
             too, since that's specifically where the "weird" live results
             get found and screenshotted. -->
        <action name="TASKMAP_TRAIL_SCAN_WHOLE_MAP" axisType="HALF"/>
    </actions>

    <inputBinding>
        <actionBinding action="TASKMAP_TRAIL_SCAN_WHOLE_MAP">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_g" index="1" />
        </actionBinding>
    </inputBinding>

    <l10n>
        <text name="input_TASKMAP_TRAIL_SCAN_WHOLE_MAP">
            <en>Rescan whole map (slow)</en>
            <de>Ganze Karte neu scannen (langsam)</de>
        </text>
        <text name="tm_fieldTitle">
            <en>Field %d</en>
            <de>Feld %d</de>
        </text>
        <text name="tm_recenter">
            <en>Recenter label</en>
            <de>Beschriftung zentrieren</de>
        </text>
        <text name="tm_crop">
            <en>Crop:</en>
            <de>Frucht:</de>
        </text>
        <text name="tm_bare">
            <en>nothing growing</en>
            <de>nichts angebaut</de>
        </text>
    </l10n>
</modDesc>
